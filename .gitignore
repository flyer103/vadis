target/
**/*.rs.bk

# local config & secrets
config.yaml
.env
*.env.local
.bootstrap-key

# autowork data (large, re-derivable)
autowork/traces/
autowork/captures/
autowork/results/
# R12-F6: corpus bodies live at <corpus-id>/raw/... — ignore every corpus's
# raw payloads, not just a corpus literally named "raw"
autowork/corpus/*/raw/
autowork/.venv/
autowork/**/__pycache__/
autowork/uv.lock.bak

# runtime state
state/
*.sqlite
*.sqlite-wal
*.sqlite-shm
logs/

.DS_Store
